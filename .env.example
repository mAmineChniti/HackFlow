# Copy to .env for local docker-compose
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Host port used to publish the web container. Change if 8000 is taken.
WEB_HOST_PORT=8000

# PostgreSQL
POSTGRES_DB=hackflow
POSTGRES_USER=hackflow
POSTGRES_PASSWORD=hackflow
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Host port used to publish the docker-compose database container.
POSTGRES_HOST_PORT=5433

# Optional: use a full URL instead of the split vars (Render/prod)
# DATABASE_URL=postgresql://hackflow:hackflow@127.0.0.1:5432/hackflow
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True
# DB_SSL_REQUIRE=False

# Optional: Redis cache for production (required for multi-worker deployments)
# REDIS_URL=redis://localhost:6379/0

# Optional: SMTP for password-reset and email-verification emails. Without
# EMAIL_HOST, Django prints emails to the console (fine for local development).
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
# Use SSL (usually port 465) instead of TLS.
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=HackFlow <hello@hackflow.dev>

# Security (production)
# These should be set to True in production with SSL enabled
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_COOKIES=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Auth hardening
# Password-reset and email-verification links live for 3 days by default.
# PASSWORD_RESET_TIMEOUT=259200
# Failed sign-ins are throttled per IP + username. Set attempts to 0 to disable.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# EMAIL_VERIFICATION_RESEND_COOLDOWN=60

# CORS (for future API endpoints)
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# CORS_ALLOW_CREDENTIALS=False

# Timezone (default: Africa/Tunis)
# Override for multi-region deployments
TIME_ZONE=Africa/Tunis

# AI (Sponsors module; staff access and projects app)
# Groq API key for AI features (email generation and project analysis)
# Set to a valid API key to enable AI features. Placeholder values will be rejected.
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Test account passwords (for setup_test_accounts.py and reset_admin.py)
# Set these to override default test passwords for local development
TEST_ADMIN_PASSWORD=admin123
TEST_ORGANIZER_PASSWORD=organizer123
TEST_JUDGE_PASSWORD=judge123
TEST_MENTOR_PASSWORD=mentor123
TEST_SARAH_PASSWORD=sarah123
TEST_ALEX_PASSWORD=alex123
TEST_ETUDIANT1_PASSWORD=etudiant123
