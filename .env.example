# Copy to .env for local docker-compose
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

MYSQL_DATABASE=hackflow
MYSQL_USER=hackflow
MYSQL_PASSWORD=hackflow
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_HOST=db
MYSQL_PORT=3306

# Optional: use full URL instead of split vars (Render/prod)
# DATABASE_URL=mysql://hackflow:hackflow@db:3306/hackflow
