# HackFlow environment template.
# Copy to .env for local Docker or bare-metal development:
#   cp .env.example .env
# Never commit .env or real credentials. Values below are safe local defaults.

# ── Django core ───────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated exact origins for CSRF POSTs. Render adds its external URL
# automatically; add custom domains here when DEBUG=False.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hackflow.example.com
TIME_ZONE=Africa/Tunis

# ── Docker Compose host ports ─────────────────────────────────────────
# Host port used to publish the web container. Change if 8000 is taken.
WEB_HOST_PORT=8000
# Host port used to publish the docker-compose database container.
POSTGRES_HOST_PORT=5433

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=hackflow
POSTGRES_USER=hackflow
POSTGRES_PASSWORD=hackflow
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: a full URL wins over the split variables above (Render/prod).
# DATABASE_URL=postgresql://hackflow:hackflow@127.0.0.1:5432/hackflow
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True
# DB_SSL_REQUIRE=False

# ── Redis / Celery async AI ───────────────────────────────────────────
# Redis is the shared cache for multi-worker production and the Celery broker
# used to run long AI calls off the request cycle. Docker Compose sets this
# automatically for the `web` and `worker` services.
# REDIS_URL=redis://localhost:6379/0
# Defaults to True when REDIS_URL is set, False otherwise (sync fallback).
# AI_ASYNC_ENABLED=True
# Without Redis, tasks run inline through Celery eager mode automatically.
# CELERY_TASK_ALWAYS_EAGER=True
# Hard limit for one AI task, in seconds.
# CELERY_TASK_TIME_LIMIT=60
# Redis redelivery delay for unacknowledged tasks. Keep it above the task limit.
# CELERY_VISIBILITY_TIMEOUT=120

# ── Email ─────────────────────────────────────────────────────────────
# Default: SMTP when EMAIL_HOST is set, otherwise the console backend.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
# Use SSL (usually port 465) instead of TLS.
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=HackFlow <hello@hackflow.dev>

# ── Security (production only) ────────────────────────────────────────
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_COOKIES=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ── Media files ───────────────────────────────────────────────────────
# Leave False behind Nginx/S3/object storage. Set True on hosts without either
# (Render free sets this in render.yaml). Render media is ephemeral.
# SERVE_MEDIA=False

# ── Auth hardening ────────────────────────────────────────────────────
# Password-reset and email-verification links live for 3 days by default.
# PASSWORD_RESET_TIMEOUT=259200
# Failed sign-ins are throttled per IP + username. Set attempts to 0 to disable.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# EMAIL_VERIFICATION_RESEND_COOLDOWN=60

# ── AI features ───────────────────────────────────────────────────────
# All external AI calls go through core/groq.py. Get a key at
# https://console.groq.com/keys. Placeholder values are rejected and fall back
# to local templates.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# AI calls are throttled per user: max requests per window, in seconds.
# Set AI_RATE_LIMIT_MAX=0 to disable the throttle.
# AI_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_WINDOW=60

# ── Sponsors module ───────────────────────────────────────────────────
# Drive sponsor permissions from accounts.Profile.role. Docker Compose and
# render.yaml enable this for the demo; set it yourself for a bare-metal run.
# SPONSORS_USE_PROFILE_ROLE=True
# Optional Django-group integration; disabled unless explicitly enabled.
# SPONSORS_USE_GROUP_ROLES=False

# ── Demo data ─────────────────────────────────────────────────────────
# This project is a demo: seeding is on by default. Set False only when you
# want an empty database. All demo users share the hardcoded password: hackflow2026
SEED_DEMO_DATA=True

# ── Runtime/deployment only ───────────────────────────────────────────
# These are normally set by Docker Compose, Render, or scripts/start-render.sh.
# PORT=8000
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
# RUN_MIGRATIONS=1
# RUN_COLLECTSTATIC=1
# RENDER_EXTERNAL_HOSTNAME and RENDER_EXTERNAL_URL are provided by Render.
# RENDER_EXTERNAL_HOSTNAME=
# RENDER_EXTERNAL_URL=
# They are added to ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS automatically.

# ── CORS (future API endpoints; currently disabled) ───────────────────
# Requires django-corsheaders and the middleware/INSTALLED_APPS changes in
# README.md. These variables have no effect until CORS is enabled.
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# CORS_ALLOW_CREDENTIALS=False


